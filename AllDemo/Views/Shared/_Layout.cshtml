<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>AllDemo - @ViewData["Title"]</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        :root {
            --primary-color: #0d6efd;
            --primary-dark: #0b5ed7;
        }

        body {
            padding-top: 70px;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .navbar {
            background: linear-gradient(to right, var(--primary-color), var(--primary-dark));
        }

        .footer {
            background-color: var(--primary-dark);
            color: white;
            text-align: center;
            padding: 15px 0;
            margin-top: auto;
        }

        .content-area {
            flex: 1;
            padding: 30px 20px;
        }
    </style>
</head>
<body>

    <!-- Top Navbar with Dropdowns -->
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top shadow">
        <div class="container-fluid">
            <a class="navbar-brand" asp-action="Index" asp-controller="Admin">Admin Dashboard</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <!-- Simple Menu -->
                    <li class="nav-item">
                        <a class="nav-link" asp-action="Index" asp-controller="Admin">Dashboard</a>
                    </li>
                    <!-- Dropdown Menu: Users -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            OTP,Email,reCAPTCHA
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" asp-action="Index" asp-controller="OTP">OTP Creation</a></li>
                            <li><a class="dropdown-item" asp-action="Index" asp-controller="Email">Sent Email</a></li>
                            <li><a class="dropdown-item" asp-action="Index" asp-controller="Captcha">Simple reCAPTCHA</a></li>
                            <li><a class="dropdown-item" asp-action="ImageReCAPTCHA" asp-controller="Captcha">Image reCAPTCHA</a></li>
                            <li><a class="dropdown-item" asp-action="reCAPTCHAVTWO" asp-controller="Captcha">reCAPTCHA-v2</a></li>
                        </ul>
                    </li>
                    <!-- Dropdown Menu: Users -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            QR Code
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" asp-action="SimpleQRCode" asp-controller="QR">Simple QRCode</a></li>
                            <li><a class="dropdown-item" asp-action="ImageResize" asp-controller="ImageResizer">Image Resizer</a></li>
                        </ul>
                    </li>
                    <!-- Dropdown Menu: Video -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            Video Downloader
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" asp-action="Downloader" asp-controller="Video">Youtube/Instagram Downloader</a></li>
                        </ul>
                    </li>
                    <!-- Dropdown Menu: Users -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            Users
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" asp-action="Index" asp-controller="Admin">User List</a></li>
                            <li><a class="dropdown-item" asp-action="Index" asp-controller="Admin">Add New User</a></li>
                            <li><a class="dropdown-item" asp-action="Index" asp-controller="Admin">Manage Roles</a></li>
                        </ul>
                    </li>

                    <!-- Dropdown Menu: Settings -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                            Settings
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" asp-action="AddRole" asp-controller="Admin">Add Role</a></li>
                            <li><a class="dropdown-item" asp-action="GetAdmissionType" asp-controller="Master">Admission Type</a></li>
                            <li><a class="dropdown-item" asp-controller="Master" asp-action="GetAcademicYear">Academic Year</a></li>
                        </ul>
                    </li>

                    <!-- Simple Link -->
                    <li class="nav-item">
                        <a class="nav-link" asp-action="Logout" asp-controller="Account">Logout</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Content -->
    <div class="container content-area">
        @RenderBody()
    </div>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <p class="mb-0">&copy; 2025 Admin Dashboard | Powered by Sirsananda</p>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>



