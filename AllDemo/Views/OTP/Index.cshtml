
@{
    ViewData["Title"] = "Create OTP";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string OTP = TempData["OTP"] as string;
}

<h1>Create OTP </h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-controller="OTP" asp-action="CreateOTP">
            @Html.AntiForgeryToken()
            <div class="form-group mt-2">
                <input type="submit" value="Create OTP" class="btn btn-primary" /> <label>@(!string.IsNullOrEmpty(OTP) ? @Html.Encode(OTP):"")
                        </label>

            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}