@section Scripts
{
    <script type="text/javascript">
            $(document).ready(function(){
            $("#secureText").on("contextmenu",function(e){ // Disable right-click context menu
                  e.preventDefault();
                 alert("Copying is disable");
             })
           // Prevent copy, cut, and paste events
        $("#secureText").on("copy cut paste", function (e) {
            e.preventDefault();
            alert("Copy/Cut/Paste are disabled on this content!");
        });

        // Optional: Prevent text selection with mouse
        $("#secureText").on("selectstart", function (e) {
            e.preventDefault();
        });

         // Copy text when button clicked
            $("#copyBtn").click(function () {
                // Get text from paragraph
                var textToCopy = $("#copytext").text();

                // Create temporary element
                var tempInput = $("<textarea>");
                $("body").append(tempInput);
                tempInput.val(textToCopy).select();
                document.execCommand("copy"); // Copy to clipboard
                tempInput.remove();

                // Notify user
                alert("Text copied successfully!");
            });

            })
    </script>
}
