<style>
    body {
        font-family: Arial, sans-serif;
    }

    p.nocopy { /* Disable text selection */
        user-select: none;
        -webkit-user-select: none;
        -moz-user-select: none;
        -ms-user-select: none;
    }

    #copyBtn {
        margin-top: 10px;
        padding: 8px 16px;
        background-color: #007bff;
        color: white;
        border: none;
        border-radius: 5px;
        cursor: pointer;
    }

        #copyBtn:hover {
