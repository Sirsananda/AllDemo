@model List<SemesterModel>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Semester List";
    string semesterIdDoestNotFind = TempData["SemesterDoesNotFind"] as string;
}
@{
    if (!string.IsNullOrEmpty(semesterIdDoestNotFind))
    {
        <div class="display-message col-md-6 card-header text-danger text-center">
            <h6 class="mb-0">@Html.Encode(semesterIdDoestNotFind) </h6>
        </div>
    }
}
<a asp-action="CreateSemester" asp-controller="Master">Create</a>
@if(Model != null && Model.Any())
{
    <h3>All Semester List</h3>
    <table class="table table-bordered table-striped">
        <thead class="table-dark">
            <tr>
                <th>Academic Year</th>
                <th>Semester Name</th>
                <th>Year Start</th>
                <th>Year End</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var semesterItem in Model)
            {
                <tr>
                    <td>@semesterItem.AcademicYear.Year_Name</td>
                    <td>@semesterItem.SemesterName</td>
                    <td>@semesterItem.StartDate</td>
                    <td>@semesterItem.EndDate</td>
                    <td>
                        <a asp-action="EditSemester" asp-controller="Master" asp-route-id="@semesterItem.SemesterId" class="btn btn-warning btn-sm">Edit</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">No Semester Found</p>
}
