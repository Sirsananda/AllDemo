@using Microsoft.CodeAnalysis.Scripting

@{
    Layout = "_Layout";
    ViewData["Title"] = "reCAPTCHA";
}
<h3 class="mb-4">@ViewData["Title"]</h3>
<hr />
<div class="captcha-box">
    <div class="col-md-1 d-flex" style="background-color:darkgrey;color:green">
        <strong class="ms-2" id="captchaText">Loading...</strong>
        <button id="reloadCaptcha" class="btn btn-secondary ms-2">↻</button>
    </div>
    <div class="col">
        <div class="col-md-2">
            <label>Enter reCAPTCHA</label>
            <input type="text" id="captchaInput" class="form-control" placeholder="Type captcha"/>
        </div>
        <div class="col-md-2 mt-3">
            <button id="submitCaptcha" class="btn btn-success">Confirm</button>
        </div>
        <div id="captchaResult" style="margin-top:10px;"></div>
    </div>
</div>

@section Scripts {
    <script type="text/javascript">
        $(document).ready(function(){
         fnLoadRECAPTCHA();
        })
        function fnLoadRECAPTCHA(){
            $.get('/Captcha/GenerateCaptcha',function(data){
                  $("#captchaText").text(data.captcha);
                   $("#captchaInput").val('');
                    $("#captchaResult").text('');
            })
        }
        $("#reloadCaptcha").on('click',function(){
             fnLoadRECAPTCHA();
        })
        $("#submitCaptcha").on('click',function(){
            const value =$("#captchaInput").val();
            
            if(value==""){
                alert("Invalid reCAPTCHA!");
                return;
            }
            $.ajax({
                url:'/Captcha/ValidateRecaptcha',
                type:'POST',
                data:{ input :parseInt(value)},
                success:function(response){
                     $("#captchaInput").val('');
                    if(response.success){
                         $('#captchaResult').html('<span class="text-success">✅ Correct!</span>');
                    }else{
                        $('#captchaResult').html('<span class="text-danger">❌ Wrong. Try again!</span>');
                    }
                }
            })
        })
    </script>
}